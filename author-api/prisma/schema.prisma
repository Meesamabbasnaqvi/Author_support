generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum UserRole {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum AiStatus {
  PENDING
  DONE
  FAILED
}

enum AiCallType {
  CLASSIFICATION
  DRAFT
}

enum AiCallStatus {
  SUCCESS
  FAILED
  CAP_EXCEEDED
}

enum FieldSource {
  DEFAULT
  AUTHOR
  AI
  ADMIN
  RULE
}

enum TicketAuditField {
  CATEGORY
  PRIORITY
}  


model Author {
  id         Int      @id @default(autoincrement())
  authorId   String   @unique
  name       String
  email      String   @unique
  phone      String?
  city       String?
  joinedDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  books   Book[]
  user    User?
  tickets Ticket[]
}

model Book {
  id                    Int      @id @default(autoincrement())
  bookId                String   @unique
  title                 String
  isbn                  String?
  genre                 String?
  publicationDate       DateTime?
  status                String
  mrp                   Decimal? @db.Decimal(10, 2)
  authorRoyaltyPerCopy  Decimal? @db.Decimal(10, 2)
  totalCopiesSold       Int      @default(0)
  totalRoyaltyEarned    Decimal  @default(0) @db.Decimal(12, 2)
  royaltyPaid           Decimal  @default(0) @db.Decimal(12, 2)
  royaltyPending        Decimal  @default(0) @db.Decimal(12, 2)
  lastRoyaltyPayoutDate DateTime?
  printPartner          String?
  availableOn           String[] @default([])

  authorId Int
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@index([authorId])
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  passwordHash    String
  role            UserRole @default(AUTHOR)

  authorId Int?    @unique
  author   Author? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  assignedTickets Ticket[]        @relation("AssignedTickets")
  sentMessages    TicketMessage[]
  internalNotes   InternalNote[]
  statusAudits    TicketStatusAudit[]
  fieldAudits     TicketFieldAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id          Int          @id @default(autoincrement())
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  statusSource FieldSource  @default(DEFAULT)

  category       TicketCategory @default(GENERAL_INQUIRY)
  categorySource FieldSource    @default(DEFAULT)
  aiCategory     TicketCategory?

  priority       TicketPriority @default(MEDIUM)
  prioritySource FieldSource    @default(DEFAULT)
  aiPriority     TicketPriority?
  priorityReason String?

  aiConfidence    Float?
  aiReason        String?
  aiStatus        AiStatus  @default(PENDING)
  aiAttempts      Int       @default(0)
  aiNextAttemptAt DateTime?
  aiLeaseToken    String?
  aiLeaseExpiresAt DateTime?

  assignedAdminId Int?
  assignedAdmin   User? @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  authorId Int
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  bookId Int?
  book   Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  messages      TicketMessage[]
  internalNotes InternalNote[]
  statusAudits  TicketStatusAudit[]
  fieldAudits   TicketFieldAudit[]
  attachments   Attachment[]
  drafts        TicketDraft[]

  createdAt DateTime @default(now())
  authorLastReadAt DateTime? 
  updatedAt DateTime @updatedAt

  @@index([authorId, updatedAt])
  @@index([status, priority, createdAt])
  @@index([category, createdAt])
  @@index([priority, createdAt])
  @@index([aiStatus, aiNextAttemptAt, aiLeaseExpiresAt])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  content   String
  isAdmin   Boolean  @default(false)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId Int?
  sender   User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  attachments Attachment[]

  @@index([ticketId, id])
}
model InternalNote {
  id      Int    @id @default(autoincrement())
  content String

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  adminId Int
  admin   User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([ticketId])
}
// FOR REVOKED TOKENSS //
model RevokedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model TicketStatusAudit {
  id         Int          @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId    Int
  admin      User         @relation(fields: [adminId], references: [id], onDelete: Restrict)
  fromStatus TicketStatus
  toStatus   TicketStatus
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([ticketId, createdAt])
}

model Attachment {
  id        Int            @id @default(autoincrement())
  filename  String
  url       String
  mimeType  String
  size      Int

  ticketId  Int?
  ticket    Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  messageId Int?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime       @default(now())

  @@index([ticketId])
  @@index([messageId])
}


model TicketFieldAudit {
  id         Int              @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId    Int
  admin      User             @relation(fields: [adminId], references: [id], onDelete: Restrict)
  field      TicketAuditField
  fromValue  String
  toValue    String
  createdAt  DateTime         @default(now())

  @@index([ticketId, createdAt])
}

model AiCall {
  id         Int          @id @default(autoincrement())
  type       AiCallType
  ticketId   Int?
  status     AiCallStatus
  durationMs Int?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([type, status, createdAt])
}

model TicketDraft {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorMsgId  Int
  body         String
  placeholders String[] @default([])
  factsUsed    Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ticketId, authorMsgId])
  @@index([ticketId])
}
