
# PostgreSQL database connection string
DATABASE_URL=

# JWT signing secret (use a strong, unique random secret)
JWT_SECRET=

# Backend server port
PORT=5000

# Allowed frontend origin for CORS
FRONTEND_URL=

# Resend API key for email services
RESEND_API_KEY=

# Google Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=

# Enable mock AI responses instead of real Gemini API calls
# Keep false in production and AI evaluation environments
USE_FAKE_AI=false
